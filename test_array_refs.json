{
  "openapi": "3.2.0",
  "components": {
    "schemas": {
      "Library": {
        "type": "object",
        "properties": {
          "books": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Book" }
          }
        },
        "required": ["books"]
      },
      "Book": {
        "type": "object",
        "properties": {
          "title": { "type": "string" }
        },
        "required": ["title"]
      }
    }
  }
}
