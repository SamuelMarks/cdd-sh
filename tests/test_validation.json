{
  "openapi": "3.2.0",
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 120
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "^[a-z0-9]+$"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": ["age", "username"]
      }
    }
  }
}
